# Secrets: Firebase config files are excluded from version control.
# They are pushed by running `flutterfire configure` after a fresh clone.
# Note: these values are not truly secret for Flutter (they ship inside the
# APK), but are kept out of the repo to avoid leaking the project binding.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist


